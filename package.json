  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "validate": "node validator/index.mjs -a --ci",
    "validate-sort": "node validator/index.mjs -a -s --ci",
